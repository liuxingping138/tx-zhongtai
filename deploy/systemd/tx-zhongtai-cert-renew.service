[Unit]
Description=Renew tx-zhongtai IP TLS certificate
After=network-online.target docker.service
Wants=network-online.target
OnFailure=tx-zhongtai-cert-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/tx-zhongtai-acme.env
WorkingDirectory=/data/tx-zhongtai
ExecStart=/usr/bin/bash /data/tx-zhongtai/scripts/renew_ip_cert.sh
UMask=0077
TimeoutStartSec=15min
