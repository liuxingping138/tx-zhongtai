# 隔离验收栈配置样例。复制为 deploy/compose/.p6.env 后使用。
# 数据库名必须带 p6，备份/恢复脚本据此拒绝误操作开发库。
# 内部 JSON 密钥沿用 compose 默认值，避免 env-file 截断花括号。
ENVIRONMENT=test
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=p6-only-change-me
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381
GATEWAY_HTTP_PORT=8090

IAM_DB_NAME=iam_p6_db
IAM_DB_USER=iam_p6
IAM_DB_PASSWORD=p6-only-change-me-iam
AUDIT_DB_NAME=audit_p6_db
AUDIT_DB_USER=audit_p6
AUDIT_DB_PASSWORD=p6-only-change-me-audit
AUDIT_CLEANUP_DB_USER=audit_p6_cleanup
AUDIT_CLEANUP_DB_PASSWORD=p6-only-change-me-cleanup
CODEBOOK_DB_NAME=codebook_p6_db
CODEBOOK_DB_USER=codebook_p6
CODEBOOK_DB_PASSWORD=p6-only-change-me-codebook

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

IAM_LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=180

ADMIN_USERNAME=p6admin
ADMIN_DISPLAY_NAME=P6验收管理员
ADMIN_PASSWORD=P6accept.ok.1
