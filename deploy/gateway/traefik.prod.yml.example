# 旧模板，使用 Docker Provider，和当前文件路由不兼容，不要直接拿来替换线上配置。
# 没有域名、按地址访问时，用同目录的 traefik.https.yml、dynamic.https.yml
# 和 deploy/compose/docker-compose.https.yml。证书续期见 scripts/renew_ip_cert.sh。

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

providers:
  docker:
    exposedByDefault: false
    network: tx-zhongtai-gateway

# 二选一：
# 1) 使用 ACME（Let's Encrypt）自动签发证书：
# certificatesResolvers:
#   letsencrypt:
#     acme:
#       email: "ops@example.com"
#       storage: "/letsencrypt/acme.json"
#       httpChallenge:
#         entryPoint: web
#
# 2) 使用已有证书文件，通过动态配置 `tls.certificates` 挂载 cert/key。

api:
  dashboard: false
  insecure: false

log:
  level: WARN

accessLog: {}

# 生产只公开网关 443；数据库、Redis、各服务端口不映射公网。
# 调试页面与公开 OpenAPI 在各服务 ENVIRONMENT=production 时自动关闭（见服务 app/main.py）。
