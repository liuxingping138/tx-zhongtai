#!/usr/bin/env bash
# 提交前的快速检查（几秒内完成）：代码规则 + 改动到的 Python 包跑 ruff。完整质量门在 pre-push。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

python3 scripts/check_code_rules.py

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
for pkg in packages/platform-common services/iam-service services/audit-service services/codebook-service services/policy-service; do
  if grep -q "^$pkg/.*\.py$" <<<"$staged"; then
    (cd "$pkg" && uv run --quiet ruff format --check . && uv run --quiet ruff check .) || {
      echo "pre-commit: $pkg 的 ruff 检查未通过" >&2
      exit 1
    }
  fi
done
