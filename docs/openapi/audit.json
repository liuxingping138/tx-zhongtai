          }
        },
        "type": "object",
        "required": [
          "event_id",
          "occurred_at",
          "outcome"
        ],
        "title": "IngestRequest",
        "description": "内部写入体。source_service 即使传入也会被忽略，以来源凭据为准。"
      },
      "JobUpdate": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "daily_time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Daily Time"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
