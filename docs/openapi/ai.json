  "components": {
    "schemas": {
      "AskBody": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 200000,
            "title": "Content"
          },
          "model_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Model Id"
          },
          "thinking": {
            "type": "boolean",
            "title": "Thinking",
            "default": false
          },
          "prompt_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content",
          "model_id"
        ],
        "title": "AskBody"
      },
      "ChatBody": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 200000,
            "title": "Message"
          },
          "model_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Model Id"
          },
          "thinking": {
            "type": "boolean",
            "title": "Thinking",
            "default": false
          },
          "previous_response_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Response Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "model_id"
        ],
        "title": "ChatBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PromptBody": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "maxLength": 200000,
            "title": "Content"
          },
          "output_fields": {
            "type": "string",
            "maxLength": 2000,
            "title": "Output Fields",
            "default": ""
          },
          "model_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Model Id",
            "default": ""
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "PromptBody"
      },
      "RunBody": {
        "properties": {
          "prompt_id": {
            "type": "string",
            "maxLength": 32,
            "title": "Prompt Id"
          },
          "model_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Model Id",
            "default": ""
          },
          "thinking": {
            "type": "boolean",
            "title": "Thinking",
            "default": false
          },
          "limit": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Limit",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt_id"
        ],
        "title": "RunBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
