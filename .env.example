# 复制为 .env 后按本机情况修改；.env 不提交仓库。
# 生产环境请使用真正随机生成的强密码/密钥，禁止直接照抄本文件的示例值。
# 注意：本文件只放原子配置值，组合出的连接串（如 IAM_DATABASE_URL）
# 在 deploy/compose/docker-compose.yml 中用变量拼接生成，避免 .env 内部互相引用的兼容性问题。

# ---------- 全局 ----------
ENVIRONMENT=development

# ---------- PostgreSQL（单实例，多数据库、多账号） ----------
# 以下超级用户仅用于容器初始化脚本创建各服务专属数据库和账号，
# 应用服务本身使用下方 IAM_DB_*/AUDIT_DB_* 专属账号连接，不使用超级用户连接业务库。
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-only-change-me

# PostgreSQL 宿主机端口。POSTGRES_BIND_ADDR 默认 127.0.0.1；Navicat 从公网连接时设为 0.0.0.0。
# Redis 不映射宿主机。REDIS_HOST_PORT 保留给旧 .env，当前 Compose 不再使用它发布端口。
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

IAM_DB_NAME=iam_db
IAM_DB_USER=iam_app
IAM_DB_PASSWORD=dev-only-change-me-iam

AUDIT_DB_NAME=audit_db
AUDIT_DB_USER=audit_app
AUDIT_DB_PASSWORD=dev-only-change-me-audit
AUDIT_CLEANUP_DB_USER=audit_cleanup
AUDIT_CLEANUP_DB_PASSWORD=dev-only-change-me-audit-cleanup

# ---------- Redis（登录限流、短期状态；不作为权限唯一数据源） ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- iam-service ----------
IAM_LOG_LEVEL=INFO
IAM_HTTP_PORT=8001
IAM_CORS_ALLOW_ORIGINS=[]
# JWT 私钥目录：不提交仓库。`make bootstrap` / `make dev-up` 会在 deploy/secrets/jwt 自动生成开发用密钥。
# IAM_JWT_KEYS_DIR 由 compose 注入为 /secrets/jwt，本地直接跑服务时默认 .jwt-keys
IAM_COOKIE_SECURE=false
IAM_ACCESS_TOKEN_TTL_SECONDS=28800
IAM_REFRESH_REUSE_GRACE_SECONDS=30
IAM_LOGIN_MAX_FAILURES=5
IAM_LOGIN_MAX_FAILURES_PER_IP=20
IAM_LOGIN_LOCKOUT_SECONDS=300
IAM_SESSION_RETENTION_DAYS=30
IAM_WORKER_LEASE_SECONDS=30
# 内部服务调用 IAM /internal/v1/* 的共享密钥。生产必须替换，且不得走网关公开。
IAM_INTERNAL_CALLER_SECRETS={"audit-service":"dev-only-change-me-internal","codebook-service":"dev-only-change-me-internal","policy-service":"dev-only-change-me-internal","ai-service":"dev-only-change-me-internal","thinktank-service":"dev-only-change-me-internal"}
IAM_AUDIT_INGEST_SECRET=dev-only-change-me-ingest

# ---------- audit-service ----------
AUDIT_LOG_LEVEL=INFO
AUDIT_HTTP_PORT=8002
AUDIT_CORS_ALLOW_ORIGINS=[]
AUDIT_RETENTION_DAYS=180
AUDIT_INTERNAL_CALLER_SECRETS={"iam-service":"dev-only-change-me-ingest","codebook-service":"dev-only-change-me-ingest","policy-service":"dev-only-change-me-ingest","ai-service":"dev-only-change-me-ingest","tender-service":"dev-only-change-me-ingest","thinktank-service":"dev-only-change-me-ingest"}
AUDIT_IAM_SERVICE_SECRET=dev-only-change-me-internal

# ---------- codebook-service ----------
CODEBOOK_DB_NAME=codebook_db
CODEBOOK_DB_USER=codebook_app
CODEBOOK_DB_PASSWORD=dev-only-change-me-codebook
CODEBOOK_LOG_LEVEL=INFO
CODEBOOK_IMPORT_MAX_BYTES=20971520
CODEBOOK_EXPORT_MAX_ROWS=100000
CODEBOOK_IAM_SERVICE_SECRET=dev-only-change-me-internal
CODEBOOK_AUDIT_INGEST_SECRET=dev-only-change-me-ingest
# AI 服务调码表服务内部接口（取系统码表）的密钥，两边共用这一个值
CODEBOOK_AI_CALLER_SECRET=dev-only-change-me-internal
# 政策 AI 打标调码表服务、调 AI 服务内部接口的密钥，各自两边共用一个值
CODEBOOK_POLICY_CALLER_SECRET=dev-only-change-me-internal
# 智库调 /internal/v1/provinces 读取省市区码表权威省份列表
CODEBOOK_THINKTANK_CALLER_SECRET=dev-only-change-me-internal
AI_POLICY_CALLER_SECRET=dev-only-change-me-internal

# ---------- ai-service（AI提问） ----------
AI_DB_NAME=ai_db
AI_DB_USER=ai_app
AI_DB_PASSWORD=dev-only-change-me-ai
AI_LOG_LEVEL=INFO
AI_UPLOAD_MAX_BYTES=20971520
AI_IAM_SERVICE_SECRET=dev-only-change-me-internal
AI_AUDIT_INGEST_SECRET=dev-only-change-me-ingest
# 大模型接口密钥：字节方舟、百度千帆。留空则对应模型在页面上显示为不可用。
AI_ARK_API_KEY=
AI_BAIDU_API_KEY=
# 批量：单个任务内的并发请求数、同时运行的任务数、心跳超时秒数。频繁限流就调小并发。
AI_BATCH_CONCURRENCY=20
AI_BATCH_MAX_RUNNING=3
AI_BATCH_STALE_SECONDS=90

# ---------- policy-service ----------
POLICY_DB_NAME=policy_db
POLICY_DB_USER=policy_app
POLICY_DB_PASSWORD=dev-only-change-me-policy
POLICY_LOG_LEVEL=INFO
POLICY_IMPORT_MAX_BYTES=20971520
POLICY_EXPORT_MAX_ROWS=100000
# 基础标签、解读的导出带政策正文（逐批到源库读），单次上限另算，取两者较小的
POLICY_EXPORT_CONTENT_MAX_ROWS=20000
POLICY_CRAWLER_HEALTH_NORMAL_DAYS=7
POLICY_CRAWLER_HEALTH_WATCH_DAYS=30
POLICY_IAM_SERVICE_SECRET=dev-only-change-me-internal
POLICY_AUDIT_INGEST_SECRET=dev-only-change-me-ingest

# 爬虫监测数据源（只读连爬虫库做按天聚合）。只有同步 CLI 用，服务进程不连。
# 建议在 MySQL 侧单独建只读账号，不要用 root。
POLICY_CRAWLER_MYSQL_HOST=
POLICY_CRAWLER_MYSQL_PORT=3306
POLICY_CRAWLER_MYSQL_USER=
POLICY_CRAWLER_MYSQL_PASSWORD=
POLICY_CRAWLER_MYSQL_DB=crawler2021
POLICY_POLICY_SOURCE_DB=bid_analyse
POLICY_CRAWLER_CONFIG_EXPAND_FROM=2026-10-26
POLICY_CRAWLER_CONFIG_BACKFILL_DATE=2026-10-22

# ---------- 网关 / Traefik ----------
# 服务器入口端口见部署手册。HTTPS 使用 deploy/compose/docker-compose.https.yml，
# 不要用 traefik.prod.yml.example 里的 Docker Provider。
GATEWAY_HTTP_PORT=8080
# HTTPS overlay 固定映射 443:443，并将 HTTP 跳转至 443；改端口需同步修改网关静态配置。

# ---------- 前端本地开发（脱离 Compose、直接 `pnpm dev` 时使用） ----------
VITE_GATEWAY_TARGET=http://localhost:8080

# 招中标服务：只读账号，仅需 bid_analyse 四张业务表及两张正文表的 SELECT 权限。
# 同时将 tender-service 的同一密钥加入 IAM_INTERNAL_CALLER_SECRETS JSON。
TENDER_IAM_SERVICE_SECRET=
TENDER_AUDIT_INGEST_SECRET=dev-only-change-me-ingest
TENDER_MYSQL_HOST=
TENDER_MYSQL_PORT=3306
TENDER_MYSQL_USER=
TENDER_MYSQL_PASSWORD=
TENDER_MYSQL_READ_TIMEOUT=20
TENDER_MYSQL_COUNT_TIMEOUT=120
TENDER_STATS_CACHE_SECONDS=300

# ---------- 智库服务（知识库及后续报告库、方案库） ----------
THINKTANK_DB_NAME=thinktank_db
THINKTANK_DB_USER=thinktank_app
THINKTANK_DB_PASSWORD=dev-only-change-me-thinktank
THINKTANK_LOG_LEVEL=INFO
THINKTANK_UPLOAD_MAX_BYTES=52428800
THINKTANK_IMPORT_MAX_BYTES=20971520
THINKTANK_EXPORT_MAX_ROWS=100000
THINKTANK_IAM_SERVICE_SECRET=dev-only-change-me-internal
THINKTANK_AUDIT_INGEST_SECRET=dev-only-change-me-ingest
# 原服务器 MinIO（不搬迁原文件时填原 MinIO 地址与桶；留空则回退本地存储）
THINKTANK_MINIO_ENDPOINT=
THINKTANK_MINIO_ACCESS_KEY=
THINKTANK_MINIO_SECRET_KEY=
THINKTANK_MINIO_BUCKET=tx-bifang-knowledge-emp-service-prod
